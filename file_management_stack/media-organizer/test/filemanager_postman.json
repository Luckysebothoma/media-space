        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/organize/related",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceDir\": \"/media/input\",\n  \"outputDir\": \"/media/processed/related\",\n  \"dryRun\": true\n}"
        }
      }
    },
    {
      "name": "Deduplicate (Dry Run)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/organize/deduplicate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceDir\": \"/media/input\",\n  \"outputDir\": \"/media/processed\",\n  \"mediaType\": \"both\",\n  \"dryRun\": true\n}"
        }
      }
    },
    {
      "name": "Deduplicate (Execute)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/organize/deduplicate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceDir\": \"/media/input\",\n  \"outputDir\": \"/media/processed\",\n  \"mediaType\": \"both\",\n  \"dryRun\": false\n}"
        }
      }
    }
  ]
}

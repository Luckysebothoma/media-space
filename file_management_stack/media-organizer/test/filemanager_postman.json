      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/organize/hour",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceDir\": \"/media/input\",\n  \"outputDir\": \"/media/processed/by-hour\",\n  \"mediaType\": \"both\",\n  \"dryRun\": true\n}"
        }
      }
    },

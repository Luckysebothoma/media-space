        "url": "{{baseUrl}}/organize/flatten",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceDir\": \"/media/input\",\n  \"outputDir\": \"/media/processed/flat\",\n  \"mediaType\": \"both\",\n  \"dryRun\": false\n}"

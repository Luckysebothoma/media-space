						"body": {
							"mode": "raw",
							"raw": "{\n    \"srcPath\": \"/data/output/organised/20260511__150mb\",\n    \"preset\": \"standard\",\n    \"threads\": 2,\n    \"muted\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/process",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"process"
							]

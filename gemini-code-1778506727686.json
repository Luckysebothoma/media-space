		{
			"name": "Organiser",
			"item": [
				{
					"name": "Organise Files",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"srcPath\": \"/data/media/imports\",\n    \"granularity\": \"day\",\n    \"mediaType\": \"both\",\n    \"dryRun\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/organise",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"organise"
							]
						},
						"description": "Groups files into folders based on date/time metadata and removes duplicates."
					},
					"response": []
				},
				{
					"name": "Scan Directory",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"srcPath\": \"/data/media/raw\",\n    \"mediaType\": \"image\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/scan",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"scan"
							]
						},
						"description": "Analyzes a directory and returns file counts and sizes without moving anything."
					},
					"response": []
				}
			]
		},
